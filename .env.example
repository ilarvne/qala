# Copy to .env. The source-grounded demo works with all provider keys blank.
# Keep private service credentials server-side. Never commit .env.

# The embedded MapLibre/OpenFreeMap 3D and 2D views need no browser API key.
# Map tiles and pedestrian routing still require network access.

# Optional server-side place sources; not used by the embedded map.
# Google: enable Places API (New), billing and an API-restricted server key.
# 2GIS: HTTP Places/Search key, not an SDK-only key.
# 2GIS requests occur when a user opens a place's Sources dialog, never on startup.
# The standalone access probe requires --live to make a request.
GOOGLE_PLACES_API_KEY=
TWOGIS_API_KEY=

# Optional LangChain enum selection over retrieved evidence. Visible text is
# rendered by trusted local templates, never arbitrary provider prose.
# Select local to disable cloud LLM calls, alemplus for AlemPlus or openai.
# If omitted, AlemPlus is selected when its key exists, otherwise OpenAI.
QALA_LLM_PROVIDER=alemplus
ALEMPLUS_API_KEY=
ALEMPLUS_MODEL=alemllm
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bounded reranking sends canonical interests and at most 16 public POI texts.
# none disables cloud reranking. Retrieval stays on the local cached index.
QALA_RERANK_PROVIDER=alemplus
ALEMPLUS_RERANK_KEY=

# Optional cloud embeddings proof only: text-1024 is not the active city index.
ALEMPLUS_EMBED_KEY=

# Explicit microphone dictation sends audio to AlemPlus; KK has its own model.
ALEMPLUS_STT_KEY=
ALEMPLUS_STT_KK_KEY=

# hash = explicit lexical feature hashes (portable fallback).
# local = prewarmed keyless multilingual MiniLM through the optional neural extra.
# See backend/README.md; runtime never downloads model weights.
# openai sends the public POI corpus and search query to OpenAI.
QALA_EMBEDDINGS=hash
QALA_EMBEDDING_CACHE=.local/embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Keyless city-level Open-Meteo forecast and official operator event calendar.
# off disables outbound context requests; offline evaluations force both off.
# Open-Meteo free service is noncommercial; use an appropriate plan for commerce.
QALA_WEATHER=on
QALA_EVENTS=on

# Optional ElevenLabs speech and private conversational agent.
# eleven_v3 supports EN/RU/KK; multilingual_v2 does not list Kazakh.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_AGENT_ID=
# Conversational model is separate from the standalone speech model above.
# Conversation presets:16 languages in data/voice-languages.json.
# UI/planner and dictation stay EN/RU/KK. The explicit account-compatible
# alternative is eleven_v3_conversational; verify access before provisioning.
ELEVENLABS_AGENT_MODEL_ID=eleven_v4_turbo
# Provisioning receipt IDs, managed by scripts/provision_elevenlabs.py.
# Reuse these IDs when moving a configured integration to another host.
ELEVENLABS_TOOL_ID=
ELEVENLABS_SECRET_ID=

# Generate a long random secret and configure the same value as the private
# ElevenLabs server-tool header X-Qala-Tool-Secret. Never put it in the browser.
VOICE_TOOL_SECRET=

# Advanced custom Twilio incoming webhook only. Native integration can instead
# be configured in ElevenLabs. PUBLIC_BASE_URL must exactly match the public
# HTTPS webhook origin, without a trailing slash; no forwarded-header guessing.
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=

# Preferences: opt-in only, coarse location 0.01 degrees, TTL30 days.
# Docker overrides this with its persistent volume path.
QALA_MEMORY_PATH=.local/preferences.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
